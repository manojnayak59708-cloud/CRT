// Problem
// Access specifier
// 7.3-- protected

#include <iostream>
using namespace std;

class parent {
protected:
   int secretCode = 1234;
   
};
class child : public parent{
public:    
     void accessOfSecretCode() {
        cout << "secretCode of the locker is " << secretCode;
    }
};

int main() {
    child obj1;
    obj1.accessOfSecretCode();
}





